---
// Le styleguide : chaque bloc réutilisable du site, rendu avec ses variantes, et la façon de
// l'écrire. Une page de travail, en français seulement, jamais indexée (noindex, robots.txt,
// absente du plan du site). Un nouveau composant s'ajoute ici le jour où il est créé.
import Base from '../../gabarits/Base.astro';
import Exemple from '../../composants/styleguide/Exemple.astro';
import Accueil from '../../composants/Accueil.astro';
import AppelRendezVous from '../../composants/AppelRendezVous.astro';
import AppelUrgence from '../../composants/AppelUrgence.astro';
import BandeauAnnonce from '../../composants/BandeauAnnonce.astro';
import Bouton from '../../composants/Bouton.astro';
import BoutonRendezVous from '../../composants/BoutonRendezVous.astro';
import Carte from '../../composants/Carte.astro';
import CarteClinique from '../../composants/CarteClinique.astro';
import CarteConseil from '../../composants/CarteConseil.astro';
import CarteDesCliniques from '../../composants/CarteDesCliniques.astro';
import CarteMembre from '../../composants/CarteMembre.astro';
import CarteService from '../../composants/CarteService.astro';
import CroixSuisse from '../../composants/CroixSuisse.astro';
import ExplicationDuSoin from '../../composants/ExplicationDuSoin.astro';
import FilDAriane from '../../composants/FilDAriane.astro';
import Horaires from '../../composants/Horaires.astro';
import Pastilles from '../../composants/Pastilles.astro';
import Photo from '../../composants/Photo.astro';
import PrixDuSoin from '../../composants/PrixDuSoin.astro';
import Prose from '../../composants/Prose.astro';
import QuestionsFrequentes from '../../composants/QuestionsFrequentes.astro';
import RendezVousDuSoin from '../../composants/RendezVousDuSoin.astro';
import ReseauDesCliniques from '../../composants/ReseauDesCliniques.astro';
import Section from '../../composants/Section.astro';
import SectionsEnCartes from '../../composants/SectionsEnCartes.astro';
import ServicesDUrgence from '../../composants/ServicesDUrgence.astro';
import StatutOuverture from '../../composants/StatutOuverture.astro';
import TeteDePage from '../../composants/TeteDePage.astro';
import { laClinique, lesCliniques } from '../../lib/cliniques.ts';
import { htmlDeLaGarde } from '../../lib/donnees-de-la-clinique.ts';
import { sections } from '../../lib/html.ts';
import { photo } from '../../lib/images.ts';
import charte from '../../styles/charte.css?raw';

const langue = 'fr';
const payerne = await laClinique('payerne');
const cliniques = await lesCliniques();
const fribourgOuest = await laClinique('fribourg');
const servicesDUrgence = [
  { nom: "Vet'Urgences Fribourg", telephone: fribourgOuest.garde.telephone, site: 'https://vet-urgence-fribourg.ch/', logo: photo('fribourg:vet-urgence-logo', langue) },
  { nom: "Vet'Urgences Neuchâtel", telephone: { affiche: '032 753 16 32', international: '+41327531632' }, site: 'https://vet-urgence-neuchatel.ch/', logo: photo('saintblaise:vet-urgence-logo', langue) },
];
// Des variantes de la fiche, pour montrer un bandeau et une fermeture. La fermeture commence dans
// dix jours et dure trois jours : l'exemple reste à venir quel que soit le jour de la construction.
const dansNJours = (n: number) => new Date(Date.now() + n * 86_400_000).toISOString().slice(0, 10);
const avecDeuxGardes = { ...payerne, garde: { ...payerne.garde, autre: { nom: "Vet'Urgences Neuchâtel", telephone: { affiche: '032 753 16 32', international: '+41327531632' }, tarif: { fr: 'numéro gratuit, de 8 h à minuit', de: 'kostenlose Nummer, von 8 bis 24 Uhr' } } } };
const avecBandeau = { ...payerne, bandeau: { texte: { fr: 'Le cabinet ferme à 16 h ce vendredi.', de: '' }, niveau: 'info' as const } };
const avecBandeauUrgent = { ...payerne, bandeau: { texte: { fr: 'Le téléphone est en dérangement ce matin : écrivez sur WhatsApp.', de: '' }, niveau: 'urgent' as const } };
const avecFermeture = { ...payerne, fermetures: [{ du: dansNJours(10), au: dansNJours(12), motif: { fr: 'formation de l’équipe', de: '' } }] };

// Les couleurs, lues dans src/styles/charte.css à la construction : chaque jeton de :root dont la
// valeur est une couleur (ou un autre jeton de couleur), avec le commentaire de sa ligne, qui dit
// son sens, rangé sous le commentaire de son groupe. Une couleur ajoutée à la charte apparaît ici.
const racine = charte.slice(charte.indexOf(':root {'), charte.indexOf('\n}', charte.indexOf(':root {')));
const groupesDeCouleurs: { titre: string; couleurs: { variable: string; valeur: string; sens: string }[] }[] = [];
const variablesDeCouleur = new Set<string>();
for (const ligne of racine.split('\n')) {
  const groupe = ligne.match(/^\s*\/\*\s*(.+?)\s*\*\/\s*$/);
  if (groupe) groupesDeCouleurs.push({ titre: groupe[1], couleurs: [] });
  const jeton = ligne.match(/^\s*(--[\w-]+):\s*([^;]+);\s*(?:\/\*\s*(.+?)\s*\*\/)?/);
  if (!jeton) continue;
  const [, variable, valeur, sens = ''] = jeton;
  const reference = valeur.match(/^var\((--[\w-]+)\)$/)?.[1];
  if (!/^(#|rgba?\()/.test(valeur) && !(reference && variablesDeCouleur.has(reference))) continue;
  variablesDeCouleur.add(variable);
  groupesDeCouleurs.at(-1)?.couleurs.push({ variable, valeur, sens });
}
const palette = groupesDeCouleurs.filter((g) => g.couleurs.length > 0);

const proseExemple = `
<p>Le chapeau, premier paragraphe d’une page, est un peu plus grand. La suite du texte garde 70 caractères par ligne.</p>
<h2>Un titre de section</h2>
<p>Un paragraphe avec un <a href="#">lien dans le texte</a> et un mot <strong>en gras</strong>.</p>
<blockquote><p>Une citation : un passage mis à part, avec le filet menthe à gauche.</p></blockquote>
<ul class="liste-de-liens">
  <li><a href="#">Radiographie</a> Os, poumons, ventre et dépistage de la dysplasie.</li>
  <li><a href="#">Échographie</a> Le ventre, le cœur et la gestation.</li>
</ul>
<div class="tableau" role="region" tabindex="0" aria-label="Tableau : Soin, Prix"><table><thead><tr><th>Soin</th><th>Prix</th></tr></thead><tbody><tr><td>Consultation de 30 minutes</td><td>57 CHF</td></tr><tr><td>Bilan annuel du chien avec vaccins</td><td>94 CHF</td></tr></tbody></table></div>
<div class="tableau tableau--empile" role="region" tabindex="0" aria-label="Tableau : Abonnement, Contenu, Prix par an"><table><thead><tr><th>Abonnement</th><th>Contenu</th><th>Prix par an</th></tr></thead><tbody><tr><td data-colonne="Abonnement">Chiot</td><td data-colonne="Contenu">Vaccins, vermifuges et deux consultations</td><td data-colonne="Prix par an">290 CHF</td></tr><tr><td data-colonne="Abonnement">Chien adulte</td><td data-colonne="Contenu">Bilan annuel, vaccins et une consultation</td><td data-colonne="Prix par an">240 CHF</td></tr><tr><td data-colonne="Abonnement"></td><td data-colonne="Contenu">Une ligne dont la première case est vide continue celle du dessus</td><td data-colonne="Prix par an"></td></tr></tbody></table></div>
<p><a class="bouton bouton--principal" href="#">Prendre rendez-vous</a></p>
${htmlDeLaGarde(payerne, langue)}`;

const sectionsExemple = sections(`
<h2>Vetmint Payerne</h2>
<p>Route du Châtelard 13, 1530 Payerne. Téléphone <a href="#">026 660 16 16</a>.</p>
${htmlDeLaGarde(payerne, langue)}
<p>Chiens, chats, lapins et rongeurs.</p>
<p><a class="bouton bouton--principal" href="#">Le cabinet Vetmint Payerne</a></p>
<h2>Une section plus courte</h2>
<p>Son bouton se pose à la même hauteur que celui de la carte voisine.</p>
<p><a class="bouton bouton--principal" href="#">Un bouton</a></p>`, 2).sections;
---

<Base langue={langue} titre="Styleguide | Vetmint" description="Les blocs réutilisables du site Vetmint, avec leurs variantes." adresses={{}} noindex>
  <TeteDePage titre="Styleguide" fil={[{ libelle: 'Accueil', href: '/' }, { libelle: 'Styleguide', href: '/styleguide/' }]} etiquetteDuFil="Vous êtes ici">
    <p class="intro">Chaque bloc du site, avec ses variantes et la façon de l’écrire. Une page se construit avec ces blocs : on n’en crée un nouveau que si aucun ne convient, et on l’ajoute ici le même jour. Les règles et le pourquoi sont dans <code>docs/charte-graphique.md</code>.</p>
  </TeteDePage>

  <div class="conteneur styleguide">
    <nav class="sommaire" aria-label="Sommaire du styleguide">
      <a href="#fondations">Fondations</a>
      <a href="#actions">Actions</a>
      <a href="#urgence">Urgence</a>
      <a href="#donnees">Données du cabinet</a>
      <a href="#cartes">Cartes</a>
      <a href="#texte">Texte</a>
      <a href="#mise-en-page">Mise en page</a>
    </nav>

    <section id="fondations">
      <h2>Fondations</h2>

      <Exemple titre="Couleurs" description="Une couleur porte un sens. Avant d’en poser une, on sait ce qu’elle code ; sinon, gris. Au survol, seule la couleur change : rien ne bouge, ne pivote ni ne grandit. Chaque couleur est un jeton de la charte, lu ici avec le commentaire qui dit son sens." fichier="styles/charte.css">
        {
          palette.map((g) => (
            <div class="couleurs">
              <p class="surtitre">{g.titre}</p>
              <div class="grille-de-cartes couleurs__liste">
                {g.couleurs.map((c) => (
                  <div class="couleur">
                    <span class="couleur__pastille" style={`--couleur: var(${c.variable})`} />
                    <p><code>var({c.variable})</code></p>
                    <p class="couleur__sens">{c.sens}</p>
                    <p class="couleur__valeur"><code>{c.valeur}</code></p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </Exemple>

      <Exemple titre="Typographie" description="Titres en Nunito 800, marine. Texte en Nunito Sans 17 px, interligne 1,55. Le surtitre, en petites capitales menthe, situe la page." fichier="styles/charte.css">
        <p class="surtitre">Cabinet vétérinaire · Payerne (VD)</p>
        <p class="apercu-titre apercu-titre--1">Titre de page, h1</p>
        <p class="apercu-titre apercu-titre--2">Titre de section, h2</p>
        <p class="apercu-titre apercu-titre--3">Titre de carte, h3</p>
        <p>Le texte courant. Le cabinet reçoit les chiens, les chats, les lapins et les rongeurs à la route du Châtelard 13.</p>
      </Exemple>

      <Exemple titre="Photo" description="Une photo du catalogue (src/assets/images/catalogue.json), encadrée, recadrée sur son point focal. Elle ne porte jamais de texte. Coins de 16 px ; arrondi={false} pour une photo qui touche les bords d’une carte." fichier="composants/Photo.astro" code={`<Photo photo={photo('payerne:locaux', langue)} ratio="4 / 3" largeur={360} />\n<Photo photo={photo('payerne:locaux', langue)} ratio="4 / 3" largeur={360} arrondi={false} />`}>
        <div class="trois">
          {photo('payerne:locaux', langue) && <Photo photo={photo('payerne:locaux', langue)!} ratio="4 / 3" largeur={360} />}
          {photo('payerne:locaux', langue) && <Photo photo={photo('payerne:locaux', langue)!} ratio="4 / 3" largeur={360} arrondi={false} />}
        </div>
      </Exemple>
    </section>

    <section id="actions">
      <h2>Actions</h2>

      <Exemple titre="Bouton" description="En pilule, en aplat. Principal, menthe plein : l’action de la page, une seule par bloc. Secondaire, contour marine : l’action d’à côté. Dans le Markdown, un lien seul sur sa ligne devient un bouton principal. « large » prend toute la largeur de son conteneur, dans une carte." fichier="composants/Bouton.astro" code={`<Bouton href="/cabinets/">Trouver son cabinet</Bouton>\n<Bouton variante="secondaire" href="tel:+41266601616">Appeler le 026 660 16 16</Bouton>\n<Bouton taille="petit">Petit bouton</Bouton>\n<Bouton href="/cabinets/" taille="petit" large>Toute la largeur</Bouton>`}>
        <div class="rangee">
          <Bouton href="#">Trouver son cabinet</Bouton>
          <Bouton variante="secondaire" href="#">Appeler le 026 660 16 16</Bouton>
          <Bouton taille="petit">Petit bouton</Bouton>
          <Bouton taille="petit" variante="secondaire">Petit secondaire</Bouton>
        </div>
        <div class="etroit"><Bouton href="#" taille="petit" large>Toute la largeur</Bouton></div>
      </Exemple>

      <Exemple titre="Bouton de rendez-vous" description="Ouvre l’agenda du cabinet dans un panneau à droite (Calendly), ou dans un onglet (VetLink). Calendly se charge quand le visiteur survole le bouton ou y pose le focus, et le panneau s’ouvre au clic. Sans JavaScript, le lien ouvre un onglet." fichier="composants/BoutonRendezVous.astro" code={`<BoutonRendezVous clinique={clinique} langue={langue} />`}>
        <div class="rangee">
          <BoutonRendezVous clinique={payerne} langue={langue} />
          <BoutonRendezVous clinique={payerne} langue={langue} variante="secondaire" taille="petit" />
        </div>
      </Exemple>

      <Exemple titre="Rendez-vous à côté du texte" description="Sur les pages longues qui ne sont pas celles d’un cabinet (un service, un conseil). La carte reste visible pendant la lecture. Le bouton mène au choix du cabinet." fichier="composants/AppelRendezVous.astro" code={`<AppelRendezVous langue={langue} />`}>
        <div class="etroit"><AppelRendezVous langue={langue} /></div>
      </Exemple>
    </section>

    <section id="urgence">
      <h2>Urgence</h2>

      <Exemple titre="Croix suisse" description="Le carré rouge du logo. Il signale l’urgence, et rien d’autre." fichier="composants/CroixSuisse.astro" code={`<CroixSuisse taille="22px" />`}>
        <div class="rangee"><CroixSuisse /> <CroixSuisse taille="32px" /></div>
      </Exemple>

      <Exemple titre="Rappel d’urgence" description="Le numéro de garde, cliquable, avec son tarif : le même libellé que le bloc « donnees: garde » d’une page. En ligne sous l’accueil d’un cabinet ; en bloc, plus grand, en tête de sa page Urgences. Un second service de garde de la région (« garde.autre » de la fiche) s’ajoute en dessous, sous son nom." fichier="composants/AppelUrgence.astro" code={`<AppelUrgence clinique={clinique} langue={langue} />\n<AppelUrgence clinique={clinique} langue={langue} forme="bloc" />`}>
        <AppelUrgence clinique={payerne} langue={langue} />
        <AppelUrgence clinique={payerne} langue={langue} forme="bloc" />
        <AppelUrgence clinique={avecDeuxGardes} langue={langue} />
      </Exemple>

      <Exemple titre="Nos services d’urgence" description="Une carte par service d’urgence de Vetmint : son logo (lien vers son site), son nom, son numéro gratuit en grand, cliquable, et ses horaires. Dans la colonne de la page Urgences du réseau ; sur un téléphone, avant le texte. Les numéros viennent des fiches de Fribourg Ouest et de Saint-Blaise." fichier="composants/ServicesDUrgence.astro" code={`<ServicesDUrgence services={[{ nom: "Vet'Urgences Fribourg", telephone, site, logo }]} langue={langue} />`}>
        <div style="max-width: 20rem;"><ServicesDUrgence services={servicesDUrgence} langue={langue} /></div>
      </Exemple>
    </section>

    <section id="donnees">
      <h2>Données du cabinet</h2>
      <p class="intro">Ces blocs lisent la fiche du cabinet (<code>src/donnees/cliniques/&lt;cabinet&gt;.json</code>). Pour changer un horaire, une fermeture ou une annonce, on change la fiche : toutes les pages suivent.</p>

      <Exemple titre="Horaires" description="Les jours qui ont les mêmes plages se regroupent. La ligne « Ouvert maintenant » se calcule dans le navigateur, à l’heure de Zurich. Les fermetures annoncées s’ajoutent dessous jusqu’à leur dernier jour. Sur fond marine, dans le pied de page, les filets et le statut passent en clair." fichier="composants/Horaires.astro" code={`<Horaires clinique={clinique} langue={langue} />`}>
        <div class="trois">
          <Carte titre="Horaires"><Horaires clinique={payerne} langue={langue} /></Carte>
          <Carte titre="Avec une fermeture"><Horaires clinique={avecFermeture} langue={langue} /></Carte>
          <div class="fond-marine sur-marine"><Horaires clinique={avecFermeture} langue={langue} /></div>
        </div>
      </Exemple>

      <Exemple titre="Statut d’ouverture" description="Seul, pour une carte de cabinet. Le point menthe dit ouvert, gris fermé." fichier="composants/StatutOuverture.astro" code={`<StatutOuverture clinique={clinique} langue={langue} />`}>
        <StatutOuverture clinique={payerne} langue={langue} />
      </Exemple>

      <Exemple titre="Bandeau d’annonce" description="En haut de chaque page du cabinet, jusqu’à sa date de fin (champ bandeau de la fiche). « urgent » le pose en rouge." fichier="composants/BandeauAnnonce.astro" code={`"bandeau": { "texte": { "fr": "…", "de": "…" }, "niveau": "info", "jusqu_au": "2026-12-24" }`}>
        <BandeauAnnonce clinique={avecBandeau} langue={langue} />
        <BandeauAnnonce clinique={avecBandeauUrgent} langue={langue} />
      </Exemple>
    </section>

    <section id="cartes">
      <h2>Cartes</h2>

      <Exemple titre="Carte" description="Fond blanc, filet gris, coins de 12 px. Elle porte un bloc d’information, avec un lien qui la termine. Son titre est un h3 par défaut ; dans une page, une carte posée directement dans une section prend niveau={2}." fichier="composants/Carte.astro" code={`<Carte titre="Venir au cabinet" niveau={2} href="/payerne/contact/" lien="Itinéraire">\n  <p>Route du Châtelard 13, 1530 Payerne</p>\n</Carte>`} fond="gris">
        <div class="trois">
          <Carte titre="Venir au cabinet" href="#" lien="Itinéraire"><p>Route du Châtelard 13, 1530 Payerne</p><p>Places de parc gratuites à proximité.</p></Carte>
          <Carte titre="Nous joindre"><p><a class="lien-fort" href="#">026 660 16 16</a></p><p>payerne@vetmint.ch</p></Carte>
        </div>
      </Exemple>

      <Exemple titre="Carte de cabinet" description="Un cabinet : nom, statut, adresse, téléphone, rendez-vous. Le lien mène à ses pages, ou à l’adresse hors ligne de sa fiche tant qu’il n’est pas en ligne. Sur les pages du cabinet lui-même, lienVersLaClinique={false} retire ce lien." fichier="composants/CarteClinique.astro" code={`<CarteClinique clinique={clinique} langue={langue} />\n<CarteClinique clinique={clinique} langue={langue} niveau={2} lienVersLaClinique={false} />`} fond="gris">
        <div class="trois">
          <CarteClinique clinique={payerne} langue={langue} />
          <CarteClinique clinique={cliniques[0]} langue={langue} />
          <CarteClinique clinique={payerne} langue={langue} lienVersLaClinique={false} />
        </div>
      </Exemple>

      <Exemple titre="Carte de service" description="Un soin : son nom, sa phrase de résumé, le lien. Toute la carte est cliquable (classe .carte--cliquable) ; au survol, le filet et le lien changent de couleur." fichier="composants/CarteService.astro" code={`<CarteService titre="Radiographie" resume="Os, poumons, ventre." href="/services/radiographie/" lien="Voir le service" />`}>
        <div class="trois">
          <CarteService titre="Radiographie" resume="Ce que montre une radio, son déroulement, la sédation et les prix." href="#" lien="Voir le service" />
          <CarteService titre="Échographie" resume="Le ventre, le cœur et la gestation." href="#" lien="Voir le service" />
        </div>
      </Exemple>

      <Exemple titre="Carte de conseil" description="Un conseil santé : photo, espèce, titre, résumé, temps de lecture. Toute la carte est cliquable (classe .carte--cliquable)." fichier="composants/CarteConseil.astro" code={`<CarteConseil titre="Le lapin" href="/conseils/le-lapin/" surtitre="Lapin et NAC" resume="…" duree="8 min de lecture" photo={photo('conseil:le-lapin', langue)} />`}>
        <div class="trois">
          <CarteConseil titre="Le lapin" href="#" surtitre="Lapin et NAC" resume="Alimentation, dents et signes d’alerte." duree="8 min de lecture" photo={photo('conseil:le-lapin', langue)} />
          <CarteConseil titre="L’obésité du chat" href="#" surtitre="Chat" resume="Savoir si votre chat est trop gros." duree="6 min de lecture" photo={photo('conseil:obesite-du-chat', langue)} />
        </div>
      </Exemple>

      <Exemple titre="Carte d’une personne" description="Une personne de l’équipe. Sans photo, un cadre clair avec ses initiales garde la même place que le portrait." fichier="composants/CarteMembre.astro" code={`<CarteMembre nom="Claire-Lise Tinguely" fonction="Vétérinaire" photo={photo('payerne:equipe:Claire-Lise Tinguely', langue)} />`} fond="gris">
        <div class="trois">
          <CarteMembre nom="Claire-Lise Tinguely" fonction="Vétérinaire" langues="Langues : français et allemand" photo={photo('payerne:equipe:Claire-Lise Tinguely', langue)} />
          <CarteMembre nom="Tiago Capelo" fonction="Vétérinaire" domaines="consultations et chirurgie" />
        </div>
      </Exemple>

      <Exemple titre="Carte des cabinets" description="La Suisse romande en SVG, sans bibliothèque de carte : les lacs, et les autoroutes A1, A5, A9 et A12 comme repères. Tous les points sont marine ; chacun mène à son cabinet. Le point survolé ou sous le focus clavier passe en menthe, comme celui du cabinet survolé dans la liste." fichier="composants/CarteDesCliniques.astro" code={`<CarteDesCliniques cliniques={cliniques} langue={langue} />`}>
        <div class="etroit"><CarteDesCliniques cliniques={cliniques} langue={langue} /></div>
      </Exemple>

      <Exemple titre="Carte et cabinets" description="La carte à côté des cabinets, sur l’accueil et la page des cabinets. Sur un grand écran, elle reste visible le long de la liste. Passer sur un cabinet allume son point, et passer sur un point allume son cabinet. Seule la couleur change." fichier="composants/ReseauDesCliniques.astro" code={`<ReseauDesCliniques cliniques={cliniques} langue={langue} />`}>
        <ReseauDesCliniques cliniques={cliniques} langue={langue} />
      </Exemple>
    </section>

    <section id="texte">
      <h2>Texte</h2>

      <Exemple titre="Texte d’une page" description="Le Markdown d’une page, mis en forme. Une liste dont chaque point commence par un lien devient une liste de cartes. Un tableau défile sur un petit écran ; de trois colonnes ou plus, il s’empile (le second tableau, à voir sur un téléphone). Une ligne dont la première case est vide continue celle du dessus : un second numéro sous le premier, par exemple. Une citation se met à part. Un bloc de données (horaires, garde) se remplit avec la fiche du cabinet." fichier="composants/Prose.astro" code={`<Prose html={html} chapeau />`}>
        <Prose html={proseExemple} chapeau />
      </Exemple>

      <Exemple titre="Texte en cartes" description="Le texte d’une page coupé à chaque titre ## (ou ###) : une carte par section, deux par ligne sur un grand écran, une seule sur un téléphone. Le bouton qui termine une section se pose en bas de sa carte. Sur la page des cabinets (##) et pour les postes ouverts de la page Emploi (###)." fichier="composants/SectionsEnCartes.astro" code={`<SectionsEnCartes sections={sections(html, 2).sections} />`} fond="gris">
        <SectionsEnCartes sections={sectionsExemple} />
      </Exemple>

      <Exemple titre="Questions fréquentes" description="Chaque question ### d’une page s’ouvre au clic, sans JavaScript. La page porte le balisage FAQPage pour les moteurs de recherche. Deux présentations : une carte par question, sur la page Questions fréquentes ; en liste (variante « filets »), un filet entre les questions, pour quelques questions dans une page qui a déjà ses cadres, comme les infos pratiques d’un soin dans un cabinet." fichier="composants/QuestionsFrequentes.astro" code={`<QuestionsFrequentes questions={[{ question: '…', reponse: '<p>…</p>' }]} />\n<QuestionsFrequentes questions={[{ question: '…', reponse: '<p>…</p>' }]} variante="filets" />`}>
        <QuestionsFrequentes
          questions={[
            { question: 'Faut-il venir à jeun pour une prise de sang ?', reponse: '<p>Oui, douze heures sans manger. L’eau reste permise.</p>' },
            { question: 'Puis-je rester pendant la consultation ?', reponse: '<p>Oui. Vous restez avec votre animal pendant tout l’examen.</p>' },
          ]}
        />
        <QuestionsFrequentes
          variante="filets"
          questions={[
            { question: 'Où se trouve le cabinet Vetmint Payerne ?', reponse: '<p>Le cabinet se trouve à la route du Châtelard 13, 1530 Payerne.</p>' },
            { question: 'Le cabinet est-il proche de chez moi ?', reponse: '<p>Ses clients viennent de Payerne et des environs.</p>' },
          ]}
        />
      </Exemple>

      <Exemple titre="Pastilles" description="Des liens courts en pastilles : sur la page d’un soin dans un cabinet, les autres soins du cabinet. Le titre visible au-dessus nomme la liste : son id se passe à idDuTitre." fichier="composants/Pastilles.astro" code={`<h2 id="autres-services">Les autres soins du cabinet</h2>\n<Pastilles liens={[{ libelle: 'Radiographie', href: '/payerne/services/radiographie/' }]} idDuTitre="autres-services" />`}>
        <p class="surtitre" id="pastilles-exemple">Les autres soins à Payerne</p>
        <Pastilles liens={[{ libelle: 'Consultation', href: '#' }, { libelle: 'Vaccination du chien', href: '#' }, { libelle: 'Radiographie', href: '#' }, { libelle: 'Soins dentaires', href: '#' }]} idDuTitre="pastilles-exemple" />
      </Exemple>

      <Exemple titre="Rendez-vous d’un soin" description="Sur la page d’un service dans un cabinet, dans la colonne de droite, à côté de la présentation, du prix et des infos pratiques : un encadré gris bleuté avec le nom du cabinet, son statut d’ouverture et son adresse, le bouton de l’agenda et le téléphone, puis, sous un filet, les conseils de rendez-vous propres au soin, tirés de la section « Prendre rendez-vous » de sa page commune. Sans conseils pour ce soin, une phrase commune les remplace. L’encadré lit sa propre largeur : dans la colonne ou sur un téléphone, les deux boutons s’empilent sur toute la largeur, comme ici ; dans un encadré large, ils se suivent en ligne." fichier="composants/RendezVousDuSoin.astro" code={`<RendezVousDuSoin clinique={clinique} conseils={html} langue={langue} />`}>
        <div class="colonne">
          <RendezVousDuSoin clinique={payerne} conseils="<p>Le détartrage se programme après une consultation : le vétérinaire examine la bouche et vous remet un devis avec le nombre probable d’extractions. Dites au téléphone que vous venez pour les dents.</p>" langue={langue} />
        </div>
      </Exemple>

      <Exemple titre="Prix d’un soin" description="Les prix d’un soin dans un cabinet, lus dans sa grille (docs/grille-des-prix.md) : une liste sans cadre, prestation à gauche, prix à droite en gras, un filet sous chaque ligne, puis le lien vers la page Tarifs du cabinet. Sans prix pour ce soin, une phrase dit que le vétérinaire annonce le prix avant de commencer. Sur la page d’un service dans un cabinet." fichier="composants/PrixDuSoin.astro" code={`<PrixDuSoin lignes={[{ libelle: 'Détartrage et polissage, anesthésie comprise', montant: '325 CHF' }]} lieu="Payerne" tarifs="/payerne/tarifs/" langue={langue} />`}>
        <PrixDuSoin lignes={[{ libelle: 'Détartrage et polissage, anesthésie comprise', montant: '325\u00a0CHF' }, { libelle: 'Extraction d’une dent, selon la dent', montant: '25 à 200\u00a0CHF' }]} lieu="Payerne" tarifs="#" langue={langue} />
      </Exemple>

      <Exemple titre="Explication d’un soin" description="Sur la page d’un service dans un cabinet : son titre, à la taille d’un titre de section, le premier paragraphe de la page commune, dont la fin s’efface sous un voile, et un bouton secondaire qui déplie le reste du texte dans la page, chargé au clic. Déplié, le bouton passe sous le texte pour le replier. Sans JavaScript, le paragraphe s’affiche en entier et le bouton ouvre la page commune. Le texte déplié n’est pas dans la page, qui reste propre au cabinet." fichier="composants/ExplicationDuSoin.astro" code={`<ExplicationDuSoin bref={html} enPhrase="la radiographie" pageCommune="/services/radiographie/" texteComplet="/textes-des-soins/fr/radiographie.html" langue={langue} />`}>
        <ExplicationDuSoin bref="<p>La radiographie du chien et du chat montre les os, les poumons, le cœur et les organes du ventre en quelques minutes.</p>" enPhrase="la radiographie" pageCommune="/services/radiographie/" texteComplet="/textes-des-soins/fr/radiographie.html" langue={langue} />
      </Exemple>

      <Exemple titre="Fil d’Ariane" description="Au-dessus du titre d’une page intérieure." fichier="composants/FilDAriane.astro" code={`<FilDAriane etapes={fil} etiquette="Vous êtes ici" />`}>
        <FilDAriane etapes={[{ libelle: 'Accueil', href: '#' }, { libelle: 'Payerne', href: '#' }, { libelle: 'Radiographie', href: '#' }]} etiquette="Exemple de fil d’Ariane" />
      </Exemple>
    </section>

    <section id="mise-en-page">
      <h2>Mise en page</h2>

      <Exemple titre="Accueil" description="Le premier écran d’un accueil : surtitre, titre, accroche, boutons, et la photo encadrée à côté du titre. Le rappel d’urgence se pose dessous." fichier="composants/Accueil.astro" code={`<Accueil surtitre="…" titre="…" accroche="…" photo={photo}>\n  <Fragment slot="actions">…</Fragment>\n</Accueil>`}>
        <!-- inert : l'exemple n'est pas lu comme un titre de la page, qui garde un seul h1 -->
        <div inert>
          <Accueil surtitre="Cabinet vétérinaire · Payerne (VD)" titre="Cabinet vétérinaire Vetmint Payerne" accroche="Route du Châtelard 13, 1530 Payerne" photo={photo('payerne:accueil', langue, 1)}>
            <Fragment slot="actions">
              <BoutonRendezVous clinique={payerne} langue={langue} />
              <Bouton variante="secondaire" href="#">Appeler le 026 660 16 16</Bouton>
            </Fragment>
            <AppelUrgence clinique={payerne} langue={langue} />
          </Accueil>
        </div>
      </Exemple>

      <Exemple titre="En-tête de page" description="L’en-tête d’une page intérieure, sur gris bleuté : fil d’Ariane, surtitre au-dessus du titre, titre, et une photo à droite si la page en a une." fichier="composants/TeteDePage.astro" code={`<TeteDePage titre="Radiographie à Payerne" fil={fil} etiquetteDuFil="Vous êtes ici" surtitre="Ce soin à Payerne" photo={photo} />`}>
        <div inert><TeteDePage titre="Radiographie à Payerne" fil={[{ libelle: 'Accueil', href: '#' }, { libelle: 'Payerne', href: '#' }, { libelle: 'Radiographie', href: '#' }]} etiquetteDuFil="Exemple" surtitre="Ce soin à Payerne" photo={photo('service:radiographie', langue)} /></div>
      </Exemple>

      <Exemple titre="Section" description="Une bande de la page, dans la largeur du site. Les fonds blanc et gris bleuté alternent d’une section à l’autre." fichier="composants/Section.astro" code={`<Section titre="Les soins du cabinet" fond="gris" id="services">…</Section>`}>
        <Section titre="Une section sur fond gris" fond="gris"><p>Le contenu de la section.</p></Section>
      </Exemple>

      <Exemple titre="Sous-section" description="Une partie du corps d’une page, sous le texte : son titre h2, à la taille d’un titre de carte, puis son contenu. Des cartes s’y rangent en grille (classe .grille-de-cartes : --min, la largeur minimale d’une colonne, 15rem par défaut ; --gap, l’écart, --espace-4 par défaut)." fichier="styles/charte.css" code={`<section class="bloc">\n  <h2>Les services du cabinet</h2>\n  <div class="grille-de-cartes" style="--min: 16rem">…</div>\n</section>`}>
        <section class="bloc">
          <h2>Les services du cabinet</h2>
          <div class="grille-de-cartes" style="--min: 16rem">
            <CarteService titre="Radiographie" resume="Os, poumons, ventre." href="#" lien="Voir le service" />
            <CarteService titre="Échographie" resume="Le ventre, le cœur et la gestation." href="#" lien="Voir le service" />
          </div>
        </section>
      </Exemple>

      <Exemple titre="Colonne latérale" description="Le corps d’une page et une colonne à côté (classe .avec-cote) : dès 1 024 px de large, la colonne de 20rem (--largeur-cote) se place à droite et reste visible pendant la lecture (.avec-cote__cote). En dessous, elle suit le corps. Les pages intérieures et l’accueil d’un cabinet l’utilisent." fichier="styles/charte.css" code={`<div class="avec-cote">\n  <div>Le corps de la page</div>\n  <aside class="avec-cote__cote">…</aside>\n</div>`}>
        <div class="avec-cote">
          <Prose html="<p>Le corps de la page : le texte, les cartes, les sous-sections. Il prend toute la largeur qui reste à côté de la colonne.</p>" />
          <aside class="avec-cote__cote"><AppelRendezVous langue={langue} /></aside>
        </div>
      </Exemple>
    </section>
  </div>
</Base>

<style>
  .intro { max-width: var(--lecture); color: var(--encre-douce); }
  .styleguide { display: grid; gap: var(--espace-7); padding-block: var(--section-y) var(--espace-8); }
  .styleguide > section { display: grid; gap: var(--espace-3); }
  .sommaire { display: flex; flex-wrap: wrap; gap: var(--espace-2) var(--espace-5); font-weight: 700; }
  .couleurs { display: grid; gap: var(--espace-3); }
  .couleurs__liste { --min: 13rem; }
  .couleur { display: grid; gap: var(--espace-1); align-content: start; font-size: var(--texte-s); }
  /* La couleur posée sur blanc à gauche et sur marine à droite : une couleur transparente, ou
     faite pour le fond marine, s'y voit. */
  .couleur__pastille { height: 64px; border-radius: var(--rayon-carte); border: 1px solid var(--trait); background: linear-gradient(var(--couleur), var(--couleur)), linear-gradient(90deg, var(--blanc) 50%, var(--marine) 50%); }
  .couleur__sens { color: var(--encre-douce); }
  .couleur__valeur { color: var(--gris); }
  /* Les tailles de titre, montrées sans être des titres : la page n'a qu'un h1. */
  .apercu-titre { font-family: var(--police-titre); font-weight: 800; color: var(--titre); line-height: 1.1; letter-spacing: -0.01em; text-wrap: balance; }
  .apercu-titre--1 { font-size: var(--titre-1); line-height: 1.05; }
  .apercu-titre--2 { font-size: var(--titre-2); }
  .apercu-titre--3 { font-size: var(--titre-3); line-height: 1.2; }
  .sur-marine { padding: var(--espace-5); border-radius: var(--rayon-carte); }
  .rangee { display: flex; flex-wrap: wrap; align-items: center; gap: var(--espace-3); }
  .trois { display: grid; gap: var(--espace-4); }
  .etroit { max-width: 420px; }
  .colonne { max-width: var(--largeur-cote); }
  code { font: 0.875em var(--police-code); }
  @media (min-width: 48rem) {
    .trois { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
