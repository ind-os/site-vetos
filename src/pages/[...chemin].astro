---
// Toutes les pages écrites en Markdown (src/content/pages/), dans les deux langues. L'adresse
// d'une page est le champ `url` de son en-tête ; son type choisit son gabarit (src/gabarits/),
// qui reçoit le contexte de la page. En prévisualisation, toutes les pages se construisent ; à la
// construction, les pages d'une clinique dont la fiche dit `"en_ligne": false` sont laissées de
// côté (pagesPubliables, src/lib/pages.ts).
import type { GetStaticPaths } from 'astro';
import { contexteDe } from '../lib/contexte.ts';
import { pagesPubliables, type Page } from '../lib/pages.ts';
import { problemesDuSite } from '../lib/verifications.ts';
import { GABARITS } from '../gabarits/index.ts';

export const getStaticPaths = (async () => {
  const problemes = await problemesDuSite();
  if (problemes.length > 0) {
    const message = `Le site ne respecte pas ses règles :\n- ${problemes.join('\n- ')}`;
    if (import.meta.env.PROD) throw new Error(message);
    console.warn(message);
  }
  return (await pagesPubliables()).map((page) => ({
    params: { chemin: page.data.url.replace(/^\/|\/$/g, '') || undefined },
    props: { page },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: Page;
}

const { page } = Astro.props;
const Gabarit = GABARITS[page.data.type];
const contexte = await contexteDe(page);
---

<Gabarit contexte={contexte} />
