---
// Le rappel d'urgence : la croix rouge, le numéro de garde cliquable et son tarif, comme le bloc
// « donnees: garde » d'une page Markdown (src/lib/donnees-de-la-clinique.ts). En ligne sous
// l'accueil d'une clinique ; en bloc, plus grand, en tête de sa page Urgences. Le rouge ne sert
// qu'à l'urgence.
import type { Langue } from '../config.ts';
import type { Clinique } from '../lib/cliniques.ts';
import { htmlDeLaGarde } from '../lib/donnees-de-la-clinique.ts';

interface Props {
  clinique: Clinique;
  langue: Langue;
  forme?: 'ligne' | 'bloc';
}

const { clinique, langue, forme = 'ligne' } = Astro.props;
---

<Fragment set:html={htmlDeLaGarde(clinique, langue, forme)} />
