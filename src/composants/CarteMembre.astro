---
// Une personne de l'équipe : son portrait, ou un cadre clair avec ses initiales, puis son nom,
// sa fonction, les langues qu'elle parle et ses domaines. Le cadre a toujours la même place.
// Avec un `portrait` (le texte de la page Équipe), toute la carte s'ouvre d'un clic : un panneau
// à droite montre la photo, la fonction et le portrait. L'adresse de la page prend l'ancre de la
// personne (/payerne/equipe/#claire-lise-tinguely), qui rouvre le panneau.
import type { Langue } from '../config.ts';
import { textes } from '../i18n/index.ts';
import { ancreDe } from '../lib/equipe.ts';
import type { Photo as PhotoDuCatalogue } from '../lib/images.ts';
import { initiales } from '../lib/format.ts';
import Photo from './Photo.astro';
import Prose from './Prose.astro';

interface Props {
  nom: string;
  fonction: string;
  /** « Dr méd. vét. ». */
  titre?: string | null;
  /** La ligne des langues : « Langues : français et allemand ». */
  langues?: string;
  domaines?: string;
  photo?: PhotoDuCatalogue;
  niveau?: 2 | 3;
  /** Le portrait de la personne, en HTML : la carte devient cliquable. */
  portrait?: string;
  /** La langue des libellés du panneau ; nécessaire avec un portrait. */
  langue?: Langue;
}

const { nom, fonction, titre, langues, domaines, photo, niveau = 3, portrait, langue = 'fr' } = Astro.props;
const Titre = `h${niveau}` as const;
const nomComplet = titre ? `${titre} ${nom}` : nom;
const t = textes(langue).equipe;
const ancre = ancreDe(nom);
const panneau = `portrait-${ancre}`;
---

<article class:list={['carte', 'membre', { 'membre--cliquable': portrait }]} id={portrait ? ancre : undefined}>
  {
    photo ? (
      <Photo photo={photo} ratio="1 / 1" largeur={320} class="membre__portrait" />
    ) : (
      <span class="membre__avatar" aria-hidden="true"><span class="membre__initiales">{initiales(nom)}</span></span>
    )
  }
  <div class="membre__texte">
    <Titre class="membre__nom">
      {
        portrait ? (
          <button type="button" class="membre__ouvrir" data-portrait={panneau} aria-haspopup="dialog">{nomComplet}</button>
        ) : (
          nomComplet
        )
      }
    </Titre>
    <p class="membre__fonction">{fonction}</p>
    {domaines && <p class="membre__detail">{domaines}</p>}
    {langues && <p class="membre__detail">{langues}</p>}
    {portrait && <p class="membre__plus" aria-hidden="true">{t.enSavoirPlus}</p>}
  </div>

  {
    portrait && (
      <dialog class="portrait" id={panneau} aria-labelledby={`${panneau}-titre`}>
        <div class="portrait__cadre">
          <div class="portrait__barre">
            <p class="portrait__titre" id={`${panneau}-titre`}>{nomComplet}</p>
            <button type="button" class="portrait__fermer" data-fermer aria-label={t.fermer}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
            </button>
          </div>
          <div class="portrait__contenu">
            {photo && <Photo photo={photo} ratio="4 / 3" largeur={560} class="portrait__photo" />}
            <div class="portrait__fiche">
              <p class="membre__fonction">{fonction}</p>
              {domaines && <p class="membre__detail">{domaines}</p>}
              {langues && <p class="membre__detail">{langues}</p>}
            </div>
            <Prose html={portrait} />
          </div>
        </div>
      </dialog>
    )
  }
</article>

<script>
  // Ouvre le panneau d'une personne au clic sur sa carte, et au chargement si l'adresse porte
  // son ancre. Fermer le panneau (bouton, touche Échap, clic sur le voile) retire l'ancre.
  const sansAncre = () => history.replaceState(null, '', location.pathname + location.search);

  function ouvrir(panneau: HTMLDialogElement) {
    if (panneau.open) return;
    panneau.showModal();
    const carte = panneau.closest<HTMLElement>('.membre');
    if (carte?.id) history.replaceState(null, '', `#${carte.id}`);
  }

  for (const bouton of document.querySelectorAll<HTMLButtonElement>('[data-portrait]')) {
    const panneau = document.getElementById(bouton.dataset.portrait!) as HTMLDialogElement | null;
    if (!panneau) continue;
    bouton.addEventListener('click', () => ouvrir(panneau));
    panneau.querySelector('[data-fermer]')?.addEventListener('click', () => panneau.close());
    // Un clic sur le voile arrive au dialogue lui-même ; un clic dans le panneau, à son cadre.
    panneau.addEventListener('click', (evenement) => {
      if (evenement.target === panneau) panneau.close();
    });
    panneau.addEventListener('close', sansAncre);
  }

  const cible = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  const panneauDeLAncre = cible?.querySelector<HTMLDialogElement>('dialog.portrait');
  if (panneauDeLAncre) ouvrir(panneauDeLAncre);
</script>

<style>
  /* Le portrait touche les bords de la carte : la marge des côtés est celle du texte. */
  .membre {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-content: start;
    align-items: start;
    gap: 18px;
    padding: 0 0 var(--marge-carte);
    overflow: hidden;
  }
  .membre__texte { display: grid; gap: var(--espace-1); padding-inline: var(--marge-carte); }
  .membre :global(.membre__portrait) { border-radius: 0; }
  .membre__avatar {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    background: var(--gris-bleute);
  }
  .membre__initiales {
    display: grid;
    place-content: center;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--blanc);
    color: var(--marine);
    font: 800 1.35rem/1 var(--police-titre);
  }
  .membre__nom { font-size: var(--titre-3); }
  .membre__fonction { color: var(--encre-douce); font-weight: 600; }
  .membre__detail { color: var(--gris); font-size: var(--texte-s); }

  /* La carte cliquable : le bouton du nom couvre toute la carte. Au survol, seule la couleur change. */
  .membre__ouvrir {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .membre__ouvrir::after { content: ''; position: absolute; inset: 0; }
  .membre__ouvrir:focus-visible { outline: none; }
  .membre--cliquable:has(.membre__ouvrir:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  /* « En savoir plus » au pied de chaque carte, à la même hauteur sur toute la rangée. */
  .membre--cliquable { grid-template-rows: auto 1fr; align-items: stretch; }
  .membre--cliquable .membre__texte { display: flex; flex-direction: column; }
  .membre__plus { margin-top: auto; padding-top: var(--espace-2); color: var(--lien); font-weight: 700; font-size: var(--texte-s); }
  .membre--cliquable:hover { border-color: var(--menthe-texte); }
  .membre--cliquable:hover .membre__nom { color: var(--lien-survol); }
  .membre--cliquable:hover .membre__plus { color: var(--lien-survol); }

  /* Le panneau du portrait, à droite, sur la page voilée : comme celui de la prise de rendez-vous. */
  .portrait {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(36rem, 100%);
    max-width: 100%;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--blanc);
    color: var(--encre);
    box-shadow: -12px 0 32px var(--ombre-panneau);
  }
  .portrait::backdrop { background: var(--voile); }
  .portrait__cadre { display: flex; flex-direction: column; height: 100%; }
  .portrait__barre {
    display: flex;
    align-items: center;
    gap: var(--espace-3);
    padding: 10px 12px 10px var(--marge-carte);
    border-bottom: 1px solid var(--trait-leger);
  }
  .portrait__titre { margin: 0; color: var(--titre); font: 800 var(--texte-m) var(--police-titre); }
  .portrait__fermer {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--cible);
    height: var(--cible);
    margin-left: auto;
    border: 2px solid var(--trait);
    border-radius: 50%;
    background: var(--blanc);
    color: var(--marine);
    cursor: pointer;
  }
  .portrait__fermer svg { width: 22px; height: 22px; }
  .portrait__fermer:hover { border-color: var(--marine); }
  .portrait__contenu { flex: 1; min-height: 0; display: grid; align-content: start; gap: var(--espace-5); padding: var(--marge-carte); overflow-y: auto; }
  .portrait__fiche { display: grid; gap: var(--espace-1); }
</style>
