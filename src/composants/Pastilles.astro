---
// Une liste de liens courts en pastilles : sur la page d'un soin dans une clinique, les autres
// soins de la clinique. Le titre visible au-dessus de la liste la nomme pour les lecteurs d'écran.
interface Props {
  liens: { libelle: string; href: string }[];
  /** L'identifiant (id) du titre visible qui nomme la liste. */
  idDuTitre: string;
}

const { liens, idDuTitre } = Astro.props;
---

<ul class="pastilles" aria-labelledby={idDuTitre}>
  {liens.map((l) => <li><a href={l.href}>{l.libelle}</a></li>)}
</ul>

<style>
  .pastilles { display: flex; flex-wrap: wrap; gap: var(--espace-2); list-style: none; margin: 0; padding: 0; }
  .pastilles a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible);
    padding: 0 1.1rem;
    border: 1px solid var(--menthe-trait);
    border-radius: var(--rayon-pilule);
    background: var(--menthe-pale);
    color: var(--menthe-fonce);
    font-weight: 700;
    font-size: var(--texte-s);
    text-decoration: none;
  }
  .pastilles a:hover { background: var(--menthe-texte); border-color: var(--menthe-texte); color: var(--blanc); }
</style>
