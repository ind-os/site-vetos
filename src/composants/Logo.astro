---
// Le logo de Vetmint, tel quel : la patte, la croix et « Vetmint ». Il mène à l'accueil
// du site. Sur les pages d'une clinique, le nom du lieu se place à droite, séparé par un filet,
// et mène à l'accueil de cette clinique. Le logo apparaît une fois par page, dans l'en-tête.
import { Image } from 'astro:assets';
import logo from '../assets/logo-vetmint.png';

interface Props {
  /** Le texte alternatif : « Vetmint, bons soins vétérinaires ». */
  alt: string;
  /** Le nom de la clinique, à droite : « Payerne ». */
  lieu?: string;
  /** Le logo Vetmint mène ici : l'accueil du site. */
  href?: string;
  /** Le nom du lieu mène ici : l'accueil de la clinique. */
  hrefLieu?: string;
  /** Le nom accessible du lien vers la clinique, s'il diffère du nom affiché. */
  libelleLieu?: string;
  /** La hauteur de l'image, en pixels. */
  hauteur?: number;
}

const { alt, lieu, href, hrefLieu, libelleLieu, hauteur = 52 } = Astro.props;
const courant = Astro.url.pathname;
---

<span class="logo" style={`--hauteur: ${hauteur}px`}>
  {
    href ? (
      <a class="logo__marque" href={href} aria-current={courant === href ? 'page' : undefined}>
        <Image src={logo} alt={alt} height={hauteur * 2} densities={[1, 2]} class="logo__image" loading="eager" />
      </a>
    ) : (
      <Image src={logo} alt={alt} height={hauteur * 2} densities={[1, 2]} class="logo__image" loading="eager" />
    )
  }
  {
    lieu &&
      (hrefLieu ? (
        <a class="logo__lieu" href={hrefLieu} aria-label={libelleLieu} aria-current={courant === hrefLieu ? 'page' : undefined}>
          {lieu}
        </a>
      ) : (
        <span class="logo__lieu">{lieu}</span>
      ))
  }
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--hauteur) * 0.28); }
  .logo__marque { display: flex; line-height: 0; text-decoration: none; border-radius: 8px; }
  .logo__image { height: var(--hauteur); width: auto; }
  .logo__lieu {
    padding-left: calc(var(--hauteur) * 0.28);
    border-left: 2px solid var(--trait);
    font: 800 calc(var(--hauteur) * 0.4) / 1.1 var(--police-titre);
    color: var(--marine);
    white-space: nowrap;
    text-decoration: none;
    border-radius: 8px;
  }
  a.logo__lieu:hover { color: var(--menthe-texte); }
</style>
