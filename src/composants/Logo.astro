---
// Le logo de Vetmint, tel quel : la patte, la croix et « Vetmint ». Il mène à l'accueil
// du site. Sur les pages d'une clinique, le nom du lieu se place à droite, séparé par un filet,
// et mène à l'accueil de cette clinique. Le logo apparaît une fois par page, dans l'en-tête.
// Sa hauteur : --hauteur-logo, posée par l'en-tête ; 52 px par défaut.
import { Image } from 'astro:assets';
import logo from '../assets/logo-vetmint.png';

interface Props {
  /** Le texte alternatif : « Vetmint, bons soins vétérinaires ». */
  alt: string;
  /** Le logo Vetmint mène ici : l'accueil du site. */
  href: string;
  /** Le lieu à droite du logo, sur les pages d'une clinique : son nom (« Payerne »), l'accueil
   *  de la clinique, et le nom accessible du lien. */
  lieu?: { nom: string; href: string; libelle: string };
}

const { alt, href, lieu } = Astro.props;
const courant = Astro.url.pathname;
// L'image est servie à deux fois la plus grande hauteur affichée (52 px), pour les écrans denses.
const HAUTEUR_DE_L_IMAGE = 104;
---

<span class="logo">
  <a class="logo__marque" href={href} aria-current={courant === href ? 'page' : undefined}>
    <Image src={logo} alt={alt} height={HAUTEUR_DE_L_IMAGE} densities={[1, 2]} class="logo__image" loading="eager" />
  </a>
  {
    lieu && (
      <a class="logo__lieu" href={lieu.href} aria-label={lieu.libelle} aria-current={courant === lieu.href ? 'page' : undefined}>
        {lieu.nom}
      </a>
    )
  }
</span>

<style>
  .logo { --hauteur: var(--hauteur-logo, 52px); display: inline-flex; align-items: center; gap: calc(var(--hauteur) * 0.28); }
  .logo__marque { display: flex; line-height: 0; text-decoration: none; border-radius: 8px; }
  .logo__image { height: var(--hauteur); width: auto; }
  .logo__lieu {
    padding-left: calc(var(--hauteur) * 0.28);
    border-left: 2px solid var(--trait);
    font: 800 calc(var(--hauteur) * 0.4) / 1.1 var(--police-titre);
    color: var(--marine);
    white-space: nowrap;
    text-decoration: none;
    border-radius: 8px;
  }
  .logo__lieu:hover { color: var(--menthe-texte); }
</style>
