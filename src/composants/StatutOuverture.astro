---
// « Ouvert maintenant, jusqu'à 12 h » ou « Fermé, ouvre lundi à 8 h », seul, pour une carte de
// clinique. Calculé dans le navigateur (src/scripts/statut-ouverture.ts) ; caché sans JavaScript.
import type { Langue } from '../config.ts';
import type { Clinique } from '../lib/cliniques.ts';

interface Props {
  clinique: Clinique;
  langue: Langue;
}

const { clinique, langue } = Astro.props;
---

<p
  class="statut"
  data-statut-ouverture
  data-langue={langue}
  data-horaires={JSON.stringify(clinique.horaires)}
  data-fermetures={JSON.stringify(clinique.fermetures)}
  hidden
>
  <span class="statut__point" aria-hidden="true"></span><span data-statut-texte></span>
</p>
