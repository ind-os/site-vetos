---
// Le rendez-vous sur la page d'un soin dans un cabinet : un encadré sur fond gris bleuté, avec le
// nom du cabinet, son statut d'ouverture et son adresse, le bouton de l'agenda et le téléphone,
// puis les conseils de rendez-vous propres au soin (tirés de sa page commune,
// src/lib/explication-du-soin.ts). Il tient lieu de carte du cabinet sur cette page ; les deux
// boutons viennent avant les conseils, pour rester visibles dès le premier écran.
import type { Langue } from '../config.ts';
import { textes } from '../i18n/index.ts';
import { adressePostale, type Clinique } from '../lib/cliniques.ts';
import { lienTelephone } from '../lib/format.ts';
import Bouton from './Bouton.astro';
import BoutonRendezVous from './BoutonRendezVous.astro';
import Prose from './Prose.astro';
import StatutOuverture from './StatutOuverture.astro';

interface Props {
  clinique: Clinique;
  /** Les conseils de rendez-vous du soin, en HTML ; à défaut, une phrase commune à tous les soins. */
  conseils: string;
  langue: Langue;
}

const { clinique, conseils, langue } = Astro.props;
const t = textes(langue);
const id = 'rendez-vous-du-soin';
---

<section class="rendez-vous-du-soin" aria-labelledby={id}>
  <h2 id={id}>{clinique.nom}</h2>
  <div class="rendez-vous-du-soin__cabinet">
    <StatutOuverture clinique={clinique} langue={langue} />
    <p class="rendez-vous-du-soin__adresse">{adressePostale(clinique)}</p>
  </div>
  <div class="rendez-vous-du-soin__actions">
    <BoutonRendezVous clinique={clinique} langue={langue} />
    <Bouton variante="secondaire" href={lienTelephone(clinique.telephone.international)}>{t.telephone.appeler(clinique.telephone.affiche)}</Bouton>
  </div>
  <div class="rendez-vous-du-soin__conseils">
    <Prose html={conseils || `<p>${t.services.rendezVousParDefaut}</p>`} />
  </div>
</section>

<style>
  /* L'encadré lit sa propre largeur : dans la colonne d'une page ou sur un téléphone, les deux
     boutons s'empilent sur toute la largeur ; dans un encadré large, ils se suivent en ligne. */
  .rendez-vous-du-soin {
    display: grid;
    gap: var(--espace-4);
    max-width: var(--lecture);
    padding: var(--espace-5);
    border-radius: var(--rayon-photo);
    background: var(--gris-bleute);
    container-type: inline-size;
  }
  /* pretty : dans la colonne, le titre se coupe entre deux mots, pas dans « rendez-vous ». */
  .rendez-vous-du-soin h2 { margin: 0; font-size: var(--titre-3); line-height: 1.2; text-wrap: pretty; }
  .rendez-vous-du-soin__cabinet { display: grid; gap: var(--espace-1); }
  .rendez-vous-du-soin__adresse { margin: 0; color: var(--encre-douce); font-size: var(--texte-s); }
  .rendez-vous-du-soin__actions { display: grid; gap: var(--espace-3); }
  .rendez-vous-du-soin__conseils { padding-top: var(--espace-4); border-top: 1px solid var(--trait); font-size: var(--texte-s); color: var(--encre-douce); }
  @container (min-width: 30rem) {
    .rendez-vous-du-soin__actions { display: flex; flex-wrap: wrap; }
  }
</style>
