---
// Un service en carte : son nom, la phrase qui le résume et le lien « Voir le service ». Toute
// la carte est cliquable (.carte--cliquable de src/styles/charte.css), le lien reste celui du titre.
interface Props {
  titre: string;
  resume?: string;
  href: string;
  lien: string;
}

const { titre, resume, href, lien } = Astro.props;
---

<article class="carte carte--cliquable service">
  <h3 class="service__titre"><a href={href}>{titre}</a></h3>
  {resume && <p class="service__resume">{resume}</p>}
  <span class="lien-fort service__lien" aria-hidden="true">{lien}</span>
</article>

<style>
  .service { display: grid; gap: var(--espace-2); align-content: start; }
  .service__titre { font-size: var(--titre-3); }
  .service__resume { color: var(--encre-douce); font-size: var(--texte-s); }
  .service__lien { margin-top: var(--espace-1); }
  .service:hover .service__lien { text-decoration: underline; color: var(--menthe-fonce); }
</style>
