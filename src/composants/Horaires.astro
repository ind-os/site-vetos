---
// Les horaires d'une clinique, jours regroupés quand ils ont les mêmes plages, avec la ligne
// « Ouvert maintenant » calculée dans le navigateur et les fermetures annoncées.
import type { Langue } from '../config.ts';
import type { Clinique } from '../lib/cliniques.ts';
import { htmlDesHoraires } from '../lib/donnees-de-la-clinique.ts';

interface Props {
  clinique: Clinique;
  langue: Langue;
}

const { clinique, langue } = Astro.props;
---

<Fragment set:html={htmlDesHoraires(clinique, langue)} />
