---
// La carte romande des huit cliniques, en SVG, sans bibliothèque de carte : les lacs en gris
// bleuté, un point par clinique placé d'après ses coordonnées. Chaque point est un lien vers la
// clinique. Le point survolé ou sous le focus clavier, et celui de la clinique survolée dans la
// liste, passent en menthe. Le halo blanc des noms prend le fond de la section (--fond).
import type { Langue } from '../config.ts';
import { textes } from '../i18n/index.ts';
import { adressePostale, lienDeLaClinique, type Clinique } from '../lib/cliniques.ts';

interface Props {
  cliniques: Clinique[];
  langue: Langue;
}

const { cliniques, langue } = Astro.props;
const t = textes(langue);

// Projection équirectangulaire calée sur Bussigny et Lausanne.
const projeter = (lat: number, lng: number) => ({
  x: Math.round((196.3 + (lng - 6.5551) * 432) * 10) / 10,
  y: Math.round((397.8 - (lat - 46.5509) * 628) * 10) / 10,
});

// La position de l'étiquette de chaque clinique, pour qu'aucune ne se chevauche.
const ETIQUETTES: Record<string, { ancre: 'start' | 'middle' | 'end'; dx: number; dy: number }> = {
  bussigny: { ancre: 'end', dx: -16, dy: -10 },
  chauxdefonds: { ancre: 'start', dx: 14, dy: 5 },
  domdidier: { ancre: 'start', dx: 14, dy: 7 },
  fribourg: { ancre: 'middle', dx: 0, dy: 27 },
  lacdejoux: { ancre: 'start', dx: 13, dy: -6 },
  payerne: { ancre: 'end', dx: -14, dy: 5 },
  saintblaise: { ancre: 'start', dx: 14, dy: 0 },
  saintlegier: { ancre: 'start', dx: 14, dy: 6 },
};

const points = await Promise.all(
  cliniques.map(async (c) => ({
    id: c.id,
    lieu: c.lieu,
    ...projeter(c.coordonnees.lat, c.coordonnees.lng),
    etiquette: ETIQUETTES[c.id] ?? { ancre: 'start', dx: 14, dy: 5 },
    lien: await lienDeLaClinique(c, langue),
    aria: `${c.nom}, ${adressePostale(c)}`,
  })),
);
const lausanne = projeter(46.5197, 6.6323);

// Les autoroutes, comme repères pour venir à la clinique : leur tracé simplifié, en [lat, lng],
// et l'endroit de leur plaque.
const AUTOROUTES: { nom: string; trace: [number, number][]; plaque: [number, number] }[] = [
  {
    nom: 'A1',
    trace: [[46.22, 6.1], [46.39, 6.22], [46.47, 6.32], [46.52, 6.48], [46.545, 6.58], [46.62, 6.56], [46.7, 6.56], [46.76, 6.62], [46.79, 6.68], [46.84, 6.83], [46.83, 6.94], [46.88, 7.04], [46.92, 7.12], [46.95, 7.3]],
    plaque: [46.73, 6.59],
  },
  {
    nom: 'A9',
    trace: [[46.545, 6.58], [46.54, 6.66], [46.5, 6.76], [46.475, 6.85], [46.45, 6.9], [46.4, 6.93], [46.32, 6.96], [46.2, 7.0]],
    plaque: [46.33, 6.96],
  },
  {
    nom: 'A12',
    trace: [[46.475, 6.85], [46.53, 6.9], [46.62, 7.05], [46.72, 7.1], [46.79, 7.14], [46.82, 7.16], [46.89, 7.32]],
    plaque: [46.62, 7.05],
  },
  {
    nom: 'A5',
    trace: [[46.79, 6.68], [46.81, 6.65], [46.85, 6.72], [46.93, 6.81], [46.95, 6.86], [46.99, 6.93], [47.01, 6.99], [47.05, 7.07], [47.1, 7.17]],
    plaque: [46.92, 6.8],
  },
];
const autoroutes = AUTOROUTES.map((a) => ({
  nom: a.nom,
  points: a.trace.map(([lat, lng]) => projeter(lat, lng)).map((p) => `${p.x},${p.y}`).join(' '),
  plaque: projeter(...a.plaque),
}));
---

<figure class="carte-cliniques">
  <svg viewBox="0 20 540 560" role="group" aria-label={t.cliniques.carte}>
    <g class="carte-cliniques__lacs" aria-hidden="true">
      <polygon points="21.3,613.8 26.9,566 39.4,544.7 60.2,503.9 79.6,480 102.1,456.1 153.9,442.3 171.2,425.4 198.4,423.5 227.4,426 252.8,428.5 271.4,437.3 320.7,454.3 341.8,466.8 349.6,473.7 357,494.4 326.7,502.6 304.3,497.6 269.7,487.5 211.4,491.9 183.3,493.8 163.9,508.9 109.9,525.2 97.3,511.4 87,516.4 61,554.1 52.4,570.4 25.6,615" />
      <polygon points="233,252 235.6,235.7 267.5,209.3 283.5,194.3 308.6,161.6 335.8,132.1 358.3,122 377.7,110.7 393.7,112 397.1,142.1 366.9,166 347.5,186.1 322,209.3 277,241.4 239.5,250.8" />
      <polygon points="399.3,171 421.3,174.2 438.6,161 442.1,154.7 436,138.4 423.1,149 407.1,160.4" />
      <polygon points="418.7,81.9 430.8,88.1 454.2,86.2 474.9,73.1 490,43.5 493.5,35.4 492.2,27.8 474.9,43.5 456.8,56.1 447.7,63 430.8,75.6" />
      <polygon points="101.6,326.1 86.1,339.8 64.5,355.5 55,365.1 69.7,362.4 91.3,345.8 103.1,334.4" />
    </g>
    <g class="carte-cliniques__autoroutes" aria-hidden="true">
      {autoroutes.map((a) => <polyline class="carte-cliniques__bord" points={a.points} />)}
      {autoroutes.map((a) => <polyline class="carte-cliniques__route" points={a.points} />)}
      {
        autoroutes.map((a) => (
          <g class="carte-cliniques__plaque">
            <rect x={a.plaque.x - 19} y={a.plaque.y - 11} width="38" height="22" rx="4" />
            <text x={a.plaque.x} y={a.plaque.y + 5}>{a.nom}</text>
          </g>
        ))
      }
    </g>
    <g class="carte-cliniques__repere" aria-hidden="true">
      <circle cx={lausanne.x} cy={lausanne.y} r="6"></circle>
      <text x={lausanne.x + 12} y={lausanne.y + 18}>Lausanne</text>
    </g>
    {
      points.map((p) => (
        <a href={p.lien} class="carte-cliniques__point" data-clinique={p.id} aria-label={p.aria}>
          <circle cx={p.x} cy={p.y} r="8" />
          <text x={p.x + p.etiquette.dx} y={p.y + p.etiquette.dy} text-anchor={p.etiquette.ancre}>{p.lieu}</text>
        </a>
      ))
    }
  </svg>
</figure>

<style>
  .carte-cliniques { margin: 0; max-width: 540px; }
  .carte-cliniques svg { width: 100%; height: auto; overflow: hidden; }
  .carte-cliniques__lacs polygon { fill: var(--lac); }
  .carte-cliniques__autoroutes polyline { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .carte-cliniques__bord { stroke: var(--fond, var(--blanc)); stroke-width: 9; }
  .carte-cliniques__route { stroke: var(--autoroute); stroke-width: 4; }
  .carte-cliniques__plaque rect { fill: var(--autoroute-plaque); stroke: var(--blanc); stroke-width: 2; }
  .carte-cliniques__plaque text { fill: var(--blanc); font: 700 14px var(--police-texte); text-anchor: middle; }
  .carte-cliniques__repere circle { fill: var(--blanc); stroke: var(--gris); stroke-width: 2; stroke-dasharray: 3 3; }
  .carte-cliniques__repere text { fill: var(--gris); font: 500 15px var(--police-texte); }
  .carte-cliniques__point circle { fill: var(--marine); stroke: var(--blanc); stroke-width: 3; transition: fill var(--transition); }
  .carte-cliniques__point text {
    fill: var(--marine);
    font: 700 17px var(--police-texte);
    paint-order: stroke;
    stroke: var(--fond, var(--blanc));
    stroke-width: 4px;
    stroke-linejoin: round;
    transition: fill var(--transition);
  }
  .carte-cliniques__point:is(:hover, :focus-visible, [data-survol]) circle { fill: var(--menthe-texte); }
  .carte-cliniques__point:is(:hover, :focus-visible, [data-survol]) text { fill: var(--menthe-fonce); }
  .carte-cliniques__point:is(:hover, :focus-visible) text { text-decoration: underline; }
  .carte-cliniques__point:focus-visible { outline: none; }
  .carte-cliniques__point:focus-visible circle { stroke: var(--focus); stroke-width: 4; }
</style>
