---
// La tête HTML d'une page : titre, description, adresse canonique, langues, partage, indexation
// et balisage schema.org.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ADRESSE_DU_SITE, CODES_DE_LANGUE, INDEXATION, type Langue } from '../config.ts';
import { enJsonLd } from '../lib/balisage.ts';

interface Props {
  langue: Langue;
  titre: string;
  description: string;
  /** L'adresse de la page dans chaque langue où elle existe. */
  adresses: Partial<Record<Langue, string>>;
  image?: ImageMetadata;
  balisage?: Record<string, unknown>[];
  /** Une page à ne jamais indexer : 404, styleguide. */
  noindex?: boolean;
}

const { langue, titre, description, adresses, image, balisage = [], noindex = false } = Astro.props;
const absolue = (chemin: string) => new URL(chemin, ADRESSE_DU_SITE).href;
const canonique = adresses[langue] ? absolue(adresses[langue]!) : undefined;
const partage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titre}</title>
<meta name="description" content={description} />
{(noindex || !INDEXATION) && <meta name="robots" content="noindex, nofollow" />}
{canonique && <link rel="canonical" href={canonique} />}
{
  Object.entries(adresses).map(([l, chemin]) => (
    <link rel="alternate" hreflang={CODES_DE_LANGUE[l as Langue]} href={absolue(chemin)} />
  ))
}
{adresses.fr && <link rel="alternate" hreflang="x-default" href={absolue(adresses.fr)} />}
<link rel="icon" href="/favicon.ico" sizes="any" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Vetmint" />
<meta property="og:locale" content={CODES_DE_LANGUE[langue].replace('-', '_')} />
<meta property="og:title" content={titre} />
<meta property="og:description" content={description} />
{canonique && <meta property="og:url" content={canonique} />}
{partage && <meta property="og:image" content={absolue(partage.src)} />}
{balisage.length > 0 && <script type="application/ld+json" set:html={enJsonLd(balisage)} />}
