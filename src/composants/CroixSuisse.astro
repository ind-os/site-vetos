---
// La croix suisse du logo, en carré rouge : elle signale l'urgence, et rien d'autre. Son style
// est la classe .croix de src/styles/donnees.css, que le numéro de garde pose aussi.
interface Props {
  /** Le côté du carré : « 22px ». */
  taille?: string;
}
const { taille = '22px' } = Astro.props;
---

<span class="croix" style={`--taille: ${taille}`} aria-hidden="true"></span>
