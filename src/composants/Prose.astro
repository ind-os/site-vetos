---
// Le texte d'une page Markdown, mis en forme : titres, listes, tableaux, boutons. Le chapeau,
// premier paragraphe, est un peu plus grand.
interface Props {
  html: string;
  chapeau?: boolean;
}

const { html, chapeau = false } = Astro.props;
---

<div class:list={['prose', { 'prose--chapeau': chapeau }]} set:html={html} />
