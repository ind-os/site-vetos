---
// Un service, page commune : ce qu'il est, comment il se passe, ses prix. À côté, le rendez-vous
// et les cliniques qui le pratiquent, chacune vers sa page du service.
import type { Contexte } from '../lib/contexte.ts';
import { lesCliniques, lienDeLaClinique } from '../lib/cliniques.ts';
import { photo } from '../lib/images.ts';
import { slugDe } from '../lib/pages.ts';
import AppelRendezVous from '../composants/AppelRendezVous.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { page, langue, t, html } = contexte;
const slug = slugDe(page);
const cliniques = await Promise.all(
  (await lesCliniques())
    .filter((c) => c.services.includes(slug))
    .map(async (c) => ({ lieu: c.lieu, href: await lienDeLaClinique(c, langue, `services/${slug}`) })),
);
---

<PageInterieure contexte={contexte} photo={photo(`service:${slug}`, langue)}>
  <Prose html={html} chapeau />
  <Fragment slot="cote">
    <AppelRendezVous langue={langue} />
    {
      cliniques.length > 0 && (
        <nav class="carte bloc liste-des-cliniques" aria-labelledby="dans-quelles-cliniques">
          <h2 id="dans-quelles-cliniques">{t.services.dansQuellesCliniques}</h2>
          <ul>{cliniques.map((c) => <li><a href={c.href}>{c.lieu}</a></li>)}</ul>
        </nav>
      )
    }
  </Fragment>
</PageInterieure>

