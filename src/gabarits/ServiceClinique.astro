---
// Un service dans un cabinet, fabriqué par le site pour chaque service de la fiche
// (src/lib/pages.ts, docs/structure-des-pages.md) : un chapeau tiré de la fiche, le bouton de
// rendez-vous, les prix du soin lus dans la grille du cabinet, puis l'explication de la page
// commune, en bref, et dépliée au clic. À côté, la carte du cabinet ; en bas, ses autres soins.
// Une page écrite dans le dossier du cabinet, pour un soin qu'il est seul à pratiquer, garde son
// texte et renvoie à la page commune si elle existe.
import type { Contexte } from '../lib/contexte.ts';
import { servicesDeLaClinique } from '../lib/cliniques.ts';
import { adresseDuTexteComplet, premierParagraphe } from '../lib/explication-du-soin.ts';
import { echapper, enumerer } from '../lib/format.ts';
import { laGrille } from '../lib/grilles.ts';
import { premierePhoto } from '../lib/images.ts';
import { adresse, estFabriquee, laPage, slugDe } from '../lib/pages.ts';
import { formaterMontant } from '../lib/prix.ts';
import BoutonRendezVous from '../composants/BoutonRendezVous.astro';
import CarteClinique from '../composants/CarteClinique.astro';
import ExplicationDuSoin from '../composants/ExplicationDuSoin.astro';
import Pastilles from '../composants/Pastilles.astro';
import PrixDuSoin from '../composants/PrixDuSoin.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { page, langue, t, html } = contexte;
const clinique = contexte.clinique!;
const slug = slugDe(page);
const fabriquee = estFabriquee(page);
const commune = await laPage(langue, `services/${slug}`);
const photoDuService = premierePhoto([`${clinique.id}:service:${slug}`, `service:${slug}`], langue);
const autres = (await servicesDeLaClinique(clinique, langue)).filter((s) => s.service !== slug);

// La page fabriquée : le chapeau dit les soins couverts et les espèces reçues, l'adresse, les
// vétérinaires et les communes d'où viennent les clients, d'après la fiche du cabinet.
const enPhrase = page.data.en_phrase ?? (page.data.nom ?? '').toLowerCase();
const especesDuService = page.data.especes ?? ['chien', 'chat', 'nac'];
const especes = enumerer(
  clinique.especes.filter((e) => especesDuService.includes(e)).map((e) => t.services.especesDansUnePhrase[e]),
  langue,
);
const { rue, localite } = clinique.adresse;
const veterinaires = (clinique.equipe ?? []).filter((p) => /^(vétérinaire|tierärzt|tierarzt)/i.test(p.fonction[langue])).map((p) => p.nom);
const communes = (clinique.communes ?? []).filter((c) => c !== localite && c !== clinique.lieu).slice(0, 4);
const chapeau = [
  t.services.introDuCabinet(clinique.lieu, page.data.soins_couverts ?? enPhrase, especes),
  t.services.adresseDuCabinet(rue, localite),
  veterinaires.length > 0 ? t.services.veterinairesDuCabinet(enumerer(veterinaires, langue), veterinaires.length) : '',
  communes.length > 0 ? t.services.clientsDuCabinet(localite, enumerer(communes, langue)) : '',
]
  .filter(Boolean)
  .join(' ')
  .replaceAll("'", '’');
const grille = await laGrille(clinique.id);
const lignes = (grille?.grille.prix ?? [])
  .filter((p) => p.service === slug)
  .map((p) => ({ libelle: p.libelle[langue], montant: formaterMontant(grille!.valeurs.get(p.cle)!, langue, 'tableau') }));
const tarifs = fabriquee ? await adresse(langue, `${clinique.id}/tarifs`) : '';
---

<PageInterieure contexte={contexte} photo={photoDuService} surtitre={t.services.pratiqueA(clinique.lieu)}>
  {
    fabriquee ? (
      <>
        <Prose html={`<p>${echapper(chapeau)}</p>`} chapeau />
        <p class="service-clinique__rendez-vous">
          <BoutonRendezVous clinique={clinique} langue={langue} />
        </p>
        <PrixDuSoin lignes={lignes} lieu={clinique.lieu} tarifs={tarifs} langue={langue} />
        {commune && (
          <ExplicationDuSoin
            bref={premierParagraphe(html)}
            enPhrase={enPhrase}
            pageCommune={commune.data.url}
            texteComplet={adresseDuTexteComplet(langue, slug)}
            langue={langue}
          />
        )}
      </>
    ) : (
      <Prose html={html} chapeau />
    )
  }
  {
    autres.length > 0 && (
      <section class="bloc">
        <h2 id="autres-services">{t.services.autresServices}</h2>
        <Pastilles liens={autres} idDuTitre="autres-services" />
      </section>
    )
  }
  <Fragment slot="cote">
    <CarteClinique clinique={clinique} langue={langue} niveau={2} lienVersLaClinique={false} />
    {!fabriquee && commune && <a class="lien-fort" href={commune.data.url}>{t.services.pageGenerale}</a>}
  </Fragment>
</PageInterieure>

<style>
  .service-clinique__rendez-vous { margin-top: var(--espace-4); }
</style>
