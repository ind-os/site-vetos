---
// Un service dans un cabinet, fabriqué par le site pour chaque service de la fiche
// (src/lib/pages.ts, docs/structure-des-pages.md) : la présentation du soin dans le cabinet, un
// encadré de rendez-vous avec les conseils propres au soin, les prix du soin lus dans la grille du
// cabinet, les infos pratiques tirées
// de la fiche, puis l'explication de la page commune, en bref, et dépliée au clic. À côté, la carte
// du cabinet ; en bas, ses autres soins.
// Une page écrite dans le dossier du cabinet, pour un soin qu'il est seul à pratiquer, garde son
// texte et renvoie à la page commune si elle existe.
import type { Contexte } from '../lib/contexte.ts';
import { servicesDeLaClinique } from '../lib/cliniques.ts';
import { adresseDuTexteComplet, conseilsDeRendezVous, premierParagraphe } from '../lib/explication-du-soin.ts';
import { echapper, enumerer, lienTelephone } from '../lib/format.ts';
import { balisageDesQuestions } from '../lib/balisage.ts';
import { laGrille } from '../lib/grilles.ts';
import { premierePhoto } from '../lib/images.ts';
import { adresse, estFabriquee, laPage, slugDe } from '../lib/pages.ts';
import { formaterMontant } from '../lib/prix.ts';
import CarteClinique from '../composants/CarteClinique.astro';
import ExplicationDuSoin from '../composants/ExplicationDuSoin.astro';
import Pastilles from '../composants/Pastilles.astro';
import PrixDuSoin from '../composants/PrixDuSoin.astro';
import Prose from '../composants/Prose.astro';
import QuestionsFrequentes from '../composants/QuestionsFrequentes.astro';
import RendezVousDuSoin from '../composants/RendezVousDuSoin.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { page, langue, t, html } = contexte;
const clinique = contexte.clinique!;
const slug = slugDe(page);
const fabriquee = estFabriquee(page);
const commune = await laPage(langue, `services/${slug}`);
const photoDuService = premierePhoto([`${clinique.id}:service:${slug}`, `service:${slug}`], langue);
const autres = (await servicesDeLaClinique(clinique, langue)).filter((s) => s.service !== slug);

// La page fabriquée : le chapeau est la présentation du soin, écrite une fois dans la page commune
// pour tous les cabinets. Les infos pratiques du cabinet, tirées de sa fiche, sont des questions
// sous les prix : l'adresse et l'accès, les vétérinaires, les communes, le rendez-vous.
const enPhrase = page.data.en_phrase ?? (page.data.nom ?? '').toLowerCase();
const chapeau = (page.data.presentation_dans_le_cabinet ?? '').replaceAll('{cabinet}', clinique.nom).replaceAll("'", '’');
const { rue, npa, localite } = clinique.adresse;
const acces = clinique.acces;
const phrase = (texte?: string) => (texte ? `${texte.replace(/[.\s]+$/, '')}.` : '');
const veterinaires = (clinique.equipe ?? []).filter((p) => /^(vétérinaire|tierärzt|tierarzt)/i.test(p.fonction[langue])).map((p) => p.nom);
const communes = (clinique.communes ?? []).filter((c) => c !== localite && c !== clinique.lieu);
const lien = (numero: { affiche: string; international: string }) => `<a href="${lienTelephone(numero.international)}">${echapper(numero.affiche)}</a>`;
const whatsapp = clinique.whatsapp
  ? clinique.whatsapp.international === clinique.telephone.international
    ? t.services.memeNumero
    : lien(clinique.whatsapp)
  : '';
const infosPratiques = [
  {
    question: t.services.ouSeTrouve(clinique.lieu),
    reponse: `<p>${echapper([t.services.adresseDuCabinet(rue, npa, localite), phrase(acces?.parking?.[langue]), phrase(acces?.transports?.[langue]), phrase(acces?.accessibilite?.[langue])].filter(Boolean).join(' '))}</p>`,
  },
  ...(veterinaires.length > 0
    ? [{ question: t.services.quiPratique(enPhrase, clinique.lieu), reponse: `<p>${echapper(t.services.veterinairesDuCabinet(enumerer(veterinaires, langue), veterinaires.length))}</p>` }]
    : []),
  ...(communes.length > 0 ? [{ question: t.services.estProche, reponse: `<p>${echapper(t.services.clientsDuCabinet(localite, enumerer(communes, langue)))}</p>` }] : []),
  { question: t.services.commentPrendreRendezVous(enPhrase), reponse: `<p>${t.services.rendezVousParTelephone(lien(clinique.telephone), whatsapp)}</p>` },
].map((q) => ({ question: q.question.replaceAll("'", '’'), reponse: q.reponse.replaceAll("'", '’') }));
const grille = await laGrille(clinique.id);
const lignes = (grille?.grille.prix ?? [])
  .filter((p) => p.service === slug)
  .map((p) => ({ libelle: p.libelle[langue], montant: formaterMontant(grille!.valeurs.get(p.cle)!, langue, 'tableau') }));
const tarifs = fabriquee ? await adresse(langue, `${clinique.id}/tarifs`) : '';
const conseils = fabriquee
  ? conseilsDeRendezVous(html, t.rendezVous.bouton, {
      aRetirer: [await adresse(langue, 'cliniques'), await adresse(langue, 'conseils/index')],
      urgences: await adresse(langue, 'urgences'),
      urgencesDuCabinet: clinique.urgences ? await adresse(langue, `${clinique.id}/urgences`) : undefined,
    })
  : '';
---

<PageInterieure contexte={contexte} photo={photoDuService} surtitre={t.services.pratiqueA(clinique.lieu)} balisage={fabriquee ? [balisageDesQuestions(infosPratiques, langue)] : []}>
  {
    fabriquee && (
      <div slot="haut" class="service-clinique__haut">
        <Prose html={`<p>${echapper(chapeau)}</p>`} chapeau />
        <div class="service-clinique__duo">
          <PrixDuSoin lignes={lignes} lieu={clinique.lieu} tarifs={tarifs} langue={langue} />
          <RendezVousDuSoin clinique={clinique} conseils={conseils} langue={langue} />
        </div>
        <section class="bloc service-clinique__infos" aria-labelledby="infos-pratiques">
          <h2 id="infos-pratiques">{t.services.infosPratiques(clinique.lieu)}</h2>
          <QuestionsFrequentes questions={infosPratiques} />
        </section>
      </div>
    )
  }
  {
    fabriquee
      ? commune && (
          <ExplicationDuSoin
            bref={premierParagraphe(html)}
            enPhrase={enPhrase}
            pageCommune={commune.data.url}
            texteComplet={adresseDuTexteComplet(langue, slug)}
            langue={langue}
          />
        )
      : <Prose html={html} chapeau />
  }
  {
    autres.length > 0 && (
      <section class="bloc">
        <h2 id="autres-services">{t.services.autresServices}</h2>
        <Pastilles liens={autres} idDuTitre="autres-services" />
      </section>
    )
  }
  <Fragment slot="cote">
    <CarteClinique clinique={clinique} langue={langue} niveau={2} lienVersLaClinique={false} />
    {!fabriquee && commune && <a class="lien-fort" href={commune.data.url}>{t.services.pageGenerale}</a>}
  </Fragment>
</PageInterieure>

<style>
  /* Le haut de la page, sur toute la largeur : la présentation, les prix et le rendez-vous côte à
     côte, puis les infos pratiques en deux colonnes. La carte du cabinet n'apparaît qu'ensuite, à
     côté de l'explication du soin, et reste visible pendant la lecture. */
  .service-clinique__haut { display: grid; gap: var(--espace-7); padding-bottom: var(--espace-4); }
  .service-clinique__duo { display: grid; gap: var(--espace-6); align-items: start; }
  @media (min-width: 64rem) {
    .service-clinique__duo { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--espace-7); }
    .service-clinique__infos :global(.faq) { max-width: none; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }
</style>
