---
// La mise en page de toutes les pages : tête HTML, bandeau d'annonce de la clinique, en-tête et
// navigation, contenu, pied de page. Une page de clinique a la navigation de sa clinique ; une
// page commune celle du réseau (src/lib/navigation.ts).
import type { ImageMetadata } from 'astro';
import '../styles/charte.css';
import { CODES_DE_LANGUE, type Langue } from '../config.ts';
import { textes } from '../i18n/index.ts';
import BandeauAnnonce from '../composants/BandeauAnnonce.astro';
import EnTete from '../composants/EnTete.astro';
import PiedDePage from '../composants/PiedDePage.astro';
import TeteHtml from '../composants/TeteHtml.astro';
import type { Clinique } from '../lib/cliniques.ts';
import { premierePhoto } from '../lib/images.ts';
import { navigationDe } from '../lib/navigation.ts';

interface Props {
  langue: Langue;
  titre: string;
  description: string;
  /** L'adresse de la page dans chaque langue où elle existe. */
  adresses: Partial<Record<Langue, string>>;
  /** La clinique de la page : sa navigation, son bandeau, son pied de page. */
  clinique?: Clinique;
  image?: ImageMetadata;
  balisage?: Record<string, unknown>[];
  noindex?: boolean;
  /** L'adresse canonique, si ce n'est pas celle de la page. */
  canonique?: string;
}

const { langue, titre, description, adresses, clinique, image, balisage, noindex, canonique } = Astro.props;
const n = textes(langue).navigation;
const autreLangue = langue === 'fr' ? 'de' : 'fr';
// Une page sans photo se partage avec la photo d'accueil de sa clinique, sinon celle du réseau.
const imageDePartage = image ?? premierePhoto(clinique ? [`${clinique.id}:accueil`, 'accueil'] : ['accueil'], langue)?.src;
const { entete, cliniques, pied, legal } = await navigationDe(langue, clinique);
---

<!doctype html>
<html lang={CODES_DE_LANGUE[langue]}>
  <head>
    <TeteHtml langue={langue} titre={titre} description={description} adresses={adresses} image={imageDePartage} balisage={balisage} noindex={noindex} canonique={canonique} />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">{n.allerAuContenu}</a>
    {clinique && <BandeauAnnonce clinique={clinique} langue={langue} />}
    <EnTete
      langue={langue}
      accueil={entete.accueil}
      lieu={entete.lieu}
      liens={entete.liens}
      urgence={entete.urgence}
      clinique={clinique}
      rendezVous={entete.rendezVous}
      autreLangue={adresses[autreLangue]}
    />
    <main id="contenu">
      <slot />
    </main>
    <PiedDePage langue={langue} clinique={clinique} cliniques={cliniques} liens={pied} legal={legal} />
    <script>
      import '../scripts/statut-ouverture.ts';
    </script>
  </body>
</html>
