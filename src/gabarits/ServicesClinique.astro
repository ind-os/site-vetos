---
// Les services d'une clinique : le texte avant le premier titre ##, une carte par soin de la
// fiche, puis la suite du texte. Chaque carte mène à la page du soin dans la clinique.
import type { Contexte } from '../lib/contexte.ts';
import { servicesDeLaClinique } from '../lib/cliniques.ts';
import { sections } from '../lib/html.ts';
import CarteService from '../composants/CarteService.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { langue, t, html } = contexte;
const clinique = contexte.clinique!;
const services = await servicesDeLaClinique(clinique, langue);
const texte = sections(html, 2);
---

<PageInterieure contexte={contexte} surtitre={t.clinique.surtitre(clinique.lieu, clinique.canton)}>
  <Prose html={texte.introduction} chapeau />
  {
    services.length > 0 && (
      <section class="bloc">
        <h2>{t.clinique.services}</h2>
        <div class="grille-de-cartes services">
          {services.map((service) => (
            <CarteService titre={service.libelle} resume={service.resume} href={service.href} lien={t.services.voir} />
          ))}
        </div>
      </section>
    )
  }
  {texte.suite && <Prose html={texte.suite} />}
</PageInterieure>

<style>
  .services { --min: 16rem; }
</style>
