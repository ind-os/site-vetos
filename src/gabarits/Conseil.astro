---
// Un conseil santé : sa photo, son texte, le rendez-vous à côté, puis trois conseils de la même espèce.
import type { Contexte } from '../lib/contexte.ts';
import { carteDuConseil } from '../lib/conseils.ts';
import { photo } from '../lib/images.ts';
import { lesPages, minutesDeLecture, slugDe } from '../lib/pages.ts';
import AppelRendezVous from '../composants/AppelRendezVous.astro';
import CarteConseil from '../composants/CarteConseil.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { page, langue, t, html } = contexte;
const slug = slugDe(page);
const espece = page.data.especes?.[0];
const lies = (await lesPages(langue, 'conseil')).filter((c) => c.id !== page.id && (!espece || c.data.especes?.includes(espece))).slice(0, 3);
---

<PageInterieure contexte={contexte} photo={photo(`conseil:${slug}`, langue)} surtitre={t.conseils.minutes(minutesDeLecture(page))}>
  <Prose html={html} chapeau />
  <AppelRendezVous slot="cote" langue={langue} />
  {
    lies.length > 0 && (
      <section class="bloc" aria-labelledby="a-lire-aussi">
        <h2 id="a-lire-aussi">{t.conseils.aLireAussi}</h2>
        <div class="grille-de-cartes">
          {lies.map((c) => <CarteConseil {...carteDuConseil(c, langue)} />)}
        </div>
      </section>
    )
  }
</PageInterieure>
