---
// Un conseil santé : sa photo, son texte, puis trois conseils de la même espèce.
import { contexteDe } from '../lib/contexte.ts';
import { photo, premierePhoto } from '../lib/images.ts';
import { lesPages, minutesDeLecture, slugDe, titreDe, type Page } from '../lib/pages.ts';
import CarteConseil from '../composants/CarteConseil.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  page: Page;
}

const contexte = await contexteDe(Astro.props.page);
const { page, langue, t, html } = contexte;
const slug = slugDe(page);
const espece = page.data.especes?.[0];
const lies = (await lesPages(langue, 'conseil')).filter((c) => c.id !== page.id && (!espece || c.data.especes?.includes(espece))).slice(0, 3);
---

<PageInterieure contexte={contexte} photo={photo(`conseil:${slug}`, langue)} surtitre={t.conseils.minutes(minutesDeLecture(page))} cote={false}>
  <Prose html={html} chapeau />
  {
    lies.length > 0 && (
      <section class="lies" aria-labelledby="a-lire-aussi">
        <h2 id="a-lire-aussi">{t.conseils.aLireAussi}</h2>
        <div class="lies__cartes">
          {lies.map((c) => (
            <CarteConseil
              titre={titreDe(c)}
              href={c.data.url}
              resume={c.data.resume}
              duree={t.conseils.minutes(minutesDeLecture(c))}
              photo={premierePhoto([`conseil:${slugDe(c)}`, `espece:${c.data.especes?.[0] ?? 'chien'}`], langue)}
            />
          ))}
        </div>
      </section>
    )
  }
</PageInterieure>

<style>
  .lies { display: grid; gap: var(--espace-4); margin-top: var(--espace-6); }
  .lies__cartes { display: grid; gap: var(--espace-4); grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
</style>
