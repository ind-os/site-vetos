---
// L'index des conseils santé, et chaque catégorie (chien, chat, NAC) : le texte de la page, puis
// les conseils en cartes, filtrés par espèce pour une catégorie. Le rendez-vous reste à côté.
import type { Contexte } from '../lib/contexte.ts';
import { carteDuConseil } from '../lib/conseils.ts';
import { lesPages } from '../lib/pages.ts';
import AppelRendezVous from '../composants/AppelRendezVous.astro';
import CarteConseil from '../composants/CarteConseil.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { page, langue, t, html } = contexte;
const espece = page.data.type === 'conseil-categorie' ? page.data.especes?.[0] : undefined;
const conseils = (await lesPages(langue, 'conseil')).filter((c) => !espece || c.data.especes?.includes(espece));
---

<PageInterieure contexte={contexte}>
  <Prose html={html} chapeau />
  <AppelRendezVous slot="cote" langue={langue} />
  <section class="grille-de-cartes conseils" aria-labelledby="liste-des-conseils">
    <h2 id="liste-des-conseils" class="visuellement-cache">{t.conseils.tous}</h2>
    {conseils.map((c) => <CarteConseil {...carteDuConseil(c, langue)} />)}
  </section>
</PageInterieure>

<style>
  .conseils { --min: 16rem; }
</style>
