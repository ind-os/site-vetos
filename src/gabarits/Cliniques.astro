---
// La page des cliniques : la carte et les huit cliniques, chacune avec son bouton de
// rendez-vous (ancre #rendez-vous du bouton de l'en-tête), puis le texte, clinique par clinique.
import { contexteDe } from '../lib/contexte.ts';
import { lesCliniques } from '../lib/cliniques.ts';
import type { Page } from '../lib/pages.ts';
import CarteClinique from '../composants/CarteClinique.astro';
import CarteDesCliniques from '../composants/CarteDesCliniques.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  page: Page;
}

const contexte = await contexteDe(Astro.props.page);
const { langue, html } = contexte;
const cliniques = await lesCliniques();
---

<PageInterieure contexte={contexte} cote={false}>
  <div class="reseau" id="rendez-vous">
    <CarteDesCliniques cliniques={cliniques} langue={langue} />
    <div class="reseau__cartes">
      {cliniques.map((c) => <CarteClinique clinique={c} langue={langue} niveau={2} />)}
    </div>
  </div>
  <Prose html={html} chapeau />
</PageInterieure>

<style>
  .reseau { display: grid; gap: var(--espace-6); scroll-margin-top: var(--espace-5); }
  .reseau__cartes { display: grid; gap: var(--espace-4); grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  @media (min-width: 72rem) {
    .reseau { grid-template-columns: 24rem minmax(0, 1fr); align-items: start; }
  }
</style>
