---
// La page des cliniques : la carte et les huit cliniques, chacune avec son bouton de
// rendez-vous (ancre #rendez-vous du bouton de l'en-tête), puis le texte : son introduction, et une
// carte par clinique, deux par ligne.
import type { Contexte } from '../lib/contexte.ts';
import { lesCliniques } from '../lib/cliniques.ts';
import { sections } from '../lib/html.ts';
import ReseauDesCliniques from '../composants/ReseauDesCliniques.astro';
import Prose from '../composants/Prose.astro';
import SectionsEnCartes from '../composants/SectionsEnCartes.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { langue, html } = contexte;
const cliniques = await lesCliniques();
const texte = sections(html, 2);
---

<PageInterieure contexte={contexte} cote={false}>
  <ReseauDesCliniques cliniques={cliniques} langue={langue} niveau={2} id="rendez-vous" />
  <Prose html={texte.introduction} chapeau />
  <SectionsEnCartes sections={texte.sections} />
</PageInterieure>
