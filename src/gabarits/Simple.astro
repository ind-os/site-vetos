---
// Une page de texte : à propos, emploi, lettre d'information, pages légales ; et pour une
// clinique, ses tarifs et ses abonnements, avec la carte de la clinique à côté. La page de
// tous les services a, à côté, le rendez-vous.
import type { Contexte } from '../lib/contexte.ts';
import AppelRendezVous from '../composants/AppelRendezVous.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { langue, page } = contexte;
---

<PageInterieure contexte={contexte}>
  <Prose html={contexte.html} chapeau />
  {page.data.type === 'service-index' && <AppelRendezVous slot="cote" langue={langue} />}
</PageInterieure>
