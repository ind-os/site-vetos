---
// Les urgences d'une clinique : le numéro de garde et son tarif d'abord, puis le texte de la page.
import type { Contexte } from '../lib/contexte.ts';
import AppelUrgence from '../composants/AppelUrgence.astro';
import Prose from '../composants/Prose.astro';
import PageInterieure from './PageInterieure.astro';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const { langue, html } = contexte;
---

<PageInterieure contexte={contexte}>
  <AppelUrgence clinique={contexte.clinique!} langue={langue} forme="bloc" />
  <Prose html={html} chapeau />
</PageInterieure>
