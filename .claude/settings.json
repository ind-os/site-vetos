{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.github/**)",
      "Edit(/Dockerfile)",
      "Edit(/nginx.conf)",
      "Edit(/src/pages/healthz.json.ts)",
      "Bash(gh secret*)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh api*)",
      "Bash(gh auth token*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth switch*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)"
    ],
    "allow": [
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(brew --version)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm verifier)",
      "Bash(pnpm auditer)",
      "Bash(node outils/*)",
      "Bash(grep*)",
      "Bash(pnpm astro dev status)",
      "Bash(pnpm astro dev stop)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git pull --rebase origin main)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git revert*)",
      "Bash(git rm -r .claude/skills/confirmer-les-faits-du-site)",
      "Bash(git push origin main)",
      "Bash(gh auth status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh variable get SITE_ADRESSE)",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__navigate"
    ]
  }
}
